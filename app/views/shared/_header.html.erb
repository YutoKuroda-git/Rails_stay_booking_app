<header class="header">
  <nav class="header_nav">
    <p class="header_text">To Stay</p>

    <ul class="header_list">
      <% if user_signed_in? %>
        <li class="user_dropdown">
          <div class="user_info">
            <!-- ユーザーアイコン（なければデフォルト） -->
            <%= image_tag(current_user.icon.presence || "default_icon.png", class: "user_icon") %>
            <span class="user_name">
              <%= current_user.name %><span class="tri">▼</span>
            </span>
          </div>

          <!-- ドロップダウンメニュー -->
          <ul class="dropdown_menu">
            <li><%= link_to "施設の新規登録", user_path %></li>
            <li class="divider"></li>
            <li><%= link_to "予約済み一覧", user_path %></li>
            <li><%= link_to "登録済み一覧", user_path %></li>
            <li><%= link_to "アカウント設定", user_path %></li>
            <li class="divider"></li>
            <li><%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } %></li>
          </ul>
        </li>
      <% else %>
      <li><%= link_to "ログイン", new_user_session_path, class: "login" %></li>
      <li><%= link_to "新規登録", new_user_registration_path, class: "btn" %></li>
    </ul>
    <% end %>
  </nav>
</header>
