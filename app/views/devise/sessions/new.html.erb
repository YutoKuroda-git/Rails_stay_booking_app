<section class="input_container">
  <div class="input_form">
    <h1 class="input_form_title">ログイン</h1>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <%= f.label :email ,"メールアドレス", class: "required_label" %>
      <%= f.text_field :email, placeholder: "メールアドレスを入力", class: "input_field", autocomplete: "email" %>

      <%= f.label :password ,"パスワード", class: "required_label" %>
      <%= f.password_field :password, placeholder: "パスワードを入力", class: "input_field", autocomplete: "current-password" %>
  
      <div class="form_action">
        <%= f.submit "ログイン", class: "submit_btn" %>
        <%= link_to "新しいアカウントを作成", new_user_registration_path, class: "login_btn" %>
      </div>
    <% end %>
  </div>
</section>
