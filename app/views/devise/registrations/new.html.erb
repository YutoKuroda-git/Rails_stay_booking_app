<div class="input_container">
  <div class="input_form">
    <h1 class="input_form_title">新規登録</h1>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= f.label :name ,"ユーザー名", class: "required_label" %>
      <%= f.text_field :name, placeholder: "ユーザー名を入力", class: "input_field", autofocus: true %>

      <%= f.label :email ,"メールアドレス", class: "required_label" %>
      <%= f.text_field :email, placeholder: "メールアドレスを入力", class: "input_field", autocomplete: "email" %>

      <%= f.label :password ,"パスワード", class: "required_label" %>
      <%= f.password_field :password, placeholder: "パスワードを入力", class: "input_field", autocomplete: "current-password" %>

      <%= f.label :password_confirmation ,"確認用パスワード", class: "required_label" %>
      <%= f.password_field :password_confirmation, placeholder: "確認用パスワードを入力", class: "input_field" %>
  
      <div class="form_action">
        <%= f.submit "新しいアカウントを作成", class: "submit_btn" %>
        <%= link_to "アカウントをお持ちの方はログイン", new_user_session_path, class: "login_btn" %>
      </div>
    <% end %>
  </div>
</div>
