<section class="user_section_container">
  <h1>設定</h1>
  <div class="user_container">
    <ul class="side_nav">
      <li class="side_nav_item1"><%= link_to "アカウント", account_user_path, class: "nav_btn #{'active' if current_page?(account_user_path)}" %></li>
      <li class="side_nav_item2"><%= link_to "プロフィール", profile_user_path, class: "nav_btn #{'active' if current_page?(profile_user_path)}" %></li>
    </ul>
    <div class="account_info">
      <div class="account_info_header">
        <h2>プロフィール</h2>
      </div>

      <%= form_with model: @user, url: profile_user_path, method: :patch do |f| %>
        <div class="account_info_main">
          <%= f.label :icon ,"アイコン画像", class: "account_info_label" %>
          <div class="icon_group">
            <% if current_user.icon.attached? %>
              <%= image_tag current_user.icon, class: "profile_icon" %>
            <% else %>
              <%= image_tag "default_icon.png", class: "profile_icon" %>
            <% end %>
            <%= f.file_field :icon, accept: "image/*", class: "upload_btn" %>
          </div>
        </div>
        <div class="account_info_main">
          <%= f.label :name ,"名前", class: "account_info_label" %>
          <%= f.text_field :name, placeholder: "名前を入力してください", autocomplete: "name", class: "input_field" %>
        </div>
        <div class="account_info_main">
          <%= f.label :introduction ,"自己紹介", class: "account_info_label" %>
          <%= f.text_area :introduction, class: "input_field_introduction" %>
        </div>

        <div class="edit_form_action">
          <%= f.submit "保存", class: "submit_edit_btn" %>
          <%= link_to "キャンセル", profile_user_path, class: "cancel_btn" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
