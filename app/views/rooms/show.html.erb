<div class="search_rooms_form_container">
    <%= form_with url: search_rooms_path, method: :get, local: true do |f| %>
        <%= f.text_field :area, placeholder: "エリア名を入力", class: "search_rooms_form_input" %>
        <%= f.text_field :keyword, placeholder: "キーワードを入力", class: "search_rooms_form_keyword" %>
        <%= f.submit "検索", class: "search_form_btn" %>
    <% end %>
</div>

<section class="room_details_container">

  <div class="room_details_header">
    <%= link_to "◀ 戻る", :back, class: "back_btn" %>
  </div>
  <div class="room_details_main">
    <% if @room.image.attached? %>
      <%= image_tag @room.image, class: "room_details_image" %>
    <% else %>
      <%= image_tag "default_image.png", class: "room_details_image" %>
    <% end %>
    <div class="room_details_info">
      <div class="room_details">
        <p class="room_details_name"><%= @room.name %></p>
        <p class="room_stars">★★★★★<span class="rating">5.0</span></p>
        <p class="room_details_text"><%= @room.address %></p>
        <p class="room_details_text"><%= @room.description %></p>
      </div>
      <div class="reservation_form">
        <p class="room_details_price">¥<%= number_with_delimiter(@room.price_per_night) %>~</p>
        <%= form_with model: [@room, @reservation], url: confirm_room_reservations_path(@room), method: :post, local: true, data: { turbo: false } do |f| %>
          <div class="reservation_box">
            <div class="date_box">
              <div class="date_item">
                <%= f.label :check_in_date, "チェックイン" %>
                <%= f.date_field :check_in_date %>
                <%= render "shared/error", obj: @reservation, field: :check_in_date %>
              </div>
              <div class="date_item">
                <%= f.label :check_out_date, "チェックアウト" %>
                <%= f.date_field :check_out_date %>
                <%= render "shared/error", obj: @reservation, field: :check_out_date %>
              </div>
            </div>

            <div class="guest_box">
              <%= f.label :guest_count, "人数" %>
              <%= f.number_field :guest_count, placeholder: "0" %>
              <%= render "shared/error", obj: @reservation, field: :guest_count %>
            </div>
          </div>
          <%= f.submit "予約する", class: "reservation_btn" %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<div class="notification">
  <% if flash[:notice] %>
    <p class="notice"><%= flash[:notice] %></p>
  <% end %>
</div>
