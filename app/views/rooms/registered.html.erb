<section class="registered_rooms_container">
  <h2>登録済み一覧</h2>
  <div class="table-responsive">
    <table class="registered_table">
      <thead>
        <tr>
          <th>画像</th>
          <th>施設名</th>
          <th>紹介文</th>
          <th>料金</th>
          <th>作成日</th>
        </tr>
      </thead>

      <tbody>
        <% @rooms.each do |room| %>
          <tr>
            <td>
              <% if room.image.attached? %>
                <%= image_tag room.image, class: "table_room_image" %>
              <% else %>
                <%= image_tag "default_image.png", class: "table_room_image" %>
              <% end %>
            </td>
            <td><%= link_to room.name, room_path(room) %></td>
            <td><%= room.description %></td>
            <td>¥<%= number_with_delimiter(room.price_per_night) %>~</td>
            <td><%= room.created_at.strftime("%Y/%m/%d") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
